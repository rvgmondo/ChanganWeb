# Copy to .env and fill in. Never commit real secrets.

# Database. SQLite: one file on the cPanel disk. (cPanel's PostgreSQL 10 is too old for
# Payload 3, and Payload does not support MySQL.)
DATABASE_URI=file:./changan.db

# Signs sessions and encrypts stored secrets. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public base URL, no trailing slash. Baked in at build time (set SITE_URL in GitHub repo vars).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: Cloudflare R2 for uploaded stock photos. Leave blank to store uploads in media/.
NEXT_PUBLIC_MEDIA_HOSTNAME=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Email via a cPanel mailbox. Blank SMTP_HOST logs emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@changanpta.co.za
# Where new leads (test drives, finance, trade-ins, enquiries) are emailed.
LEADS_TO=info@changanpta.co.za

# Analytics. Only loaded after the visitor accepts cookies (POPIA).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# WhatsApp click-to-chat number in international format, digits only.
NEXT_PUBLIC_WHATSAPP=27120233433
